        <mxCell id="c287" value="• resource-aware admission (measured memory/swap)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A-card-4"><mxGeometry x="10" y="129.45" width="307.84" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c288" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#16181c;strokeColor=#f0c060;strokeWidth=1.2;dashed=1;dashPattern=5 4;fixDash=1;html=1;whiteSpace=wrap;" vertex="1" parent="lane-A"><mxGeometry x="2056" y="58" width="2244" height="216" as="geometry"/></mxCell>
        <mxCell id="c289" value="OUTPUTS  →  who consumes them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=12;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="2070" y="69.4" width="214.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c290" value="→ merged names / types / comments PER FIELD, each with origin and rejected alternatives" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="2070" y="93.93" width="566.28" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c291" value="→ consumed by stage 5 placement (type-compatibility gate) and by the ABI + struct blocks of the pack" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="2070" y="110.93" width="650" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c292" value="→ surfaces in the readiness report as which build donated which field" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="2070" y="127.93" width="450.36" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c293" value="→ never overwrites a stronger field; conflicts stay visible for review" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="2070" y="144.93" width="456.8" height="16.1" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Lane B: Cross-build entity unification &amp; export — every entity, not just functions&#10;&#10;In the app: `?node=lane-B`&#10;&#10;- Family: cross-build unification &amp; export (UNIFICATION &amp; EXPORT)&#10;- Catalog verbs: unmapped (no recorded mapping)&#10;- Connects: consumes stages 1 to 2 (+ raw images), feeds lane C and the export bundle&#10;- Scope: portable signatures, entity catalog, data-root locator families with fallbacks, divergence, codecaves, ABI — feeds the runtime pack&#10;- Outputs and who consumes them:&#10;  - logical_signature per entity + per-build coverage, entities[] catalog (30 kinds, pack enum)&#10;  - data-root recipes with ordered fallbacks, divergence class per pair, caves[] + ABI blocks&#10;  - all of it lands in hookpack v2 then consumed by lane C (runtime) and the export bundle&#10;  - generic core + adapters: a new engine adds an L3 data pack, never core code" link="agentdecompile-recovery-pipeline.outline.md#lane-B" id="lane-B"><mxCell style="group" vertex="1" connectable="0" parent="L3"><mxGeometry x="60" y="934" width="4300" height="306" as="geometry"/></mxCell></UserObject>
