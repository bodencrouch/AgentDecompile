        <mxCell id="c579" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#b0b6c2;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="85.98" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c580" value="• attach-first: find the running local agent, never a second start" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="100.45" width="412.56" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c581" value="• canaries prove capability: python · parity · toolchain · analyzer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="114.95" width="418.72" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c582" value="• capability decides lanes and fetches — a role never does" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="129.45" width="363.28" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c583" value="• roles decide only mirrors + who signs invites / verifies / applies" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="143.95" width="424.88" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c584" value="• outbound HTTPS only; no inbound port; --idle-only, --cores N" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c974"><mxGeometry x="10" y="158.45" width="387.92" height="15.4" as="geometry"/></mxCell>
