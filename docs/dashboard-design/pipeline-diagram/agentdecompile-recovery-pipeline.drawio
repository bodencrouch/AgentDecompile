        <mxCell id="c618" value="• identity / logical / match / knowledge / receipts from deltas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c976"><mxGeometry x="10" y="114.95" width="394.08" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c619" value="• view-stale is a named state with an age (H11), never a stall" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c976"><mxGeometry x="10" y="129.45" width="387.92" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c620" value="• no worker ever opens a view for writing (H1 by construction)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c976"><mxGeometry x="10" y="143.95" width="387.92" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c621" value="• adgrid view materialize rebuilds from record 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c976"><mxGeometry x="10" y="158.45" width="301.68" height="15.4" as="geometry"/></mxCell>
