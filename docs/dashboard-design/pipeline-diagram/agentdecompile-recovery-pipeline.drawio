        <mxCell id="c652" value="OUTPUTS  →  who consumes them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=12;fontColor=#b0b6c2;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c961"><mxGeometry x="14" y="11.4" width="214.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c653" value="→ one package (CLI adgrid) reusable for any CPU/IO-heavy work; the pipeline's lanes are adapters over it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c961"><mxGeometry x="14" y="35.92" width="675.76" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c654" value="→ planned grid contracts; implementation status belongs to delivery evidence, not this design diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c961"><mxGeometry x="14" y="52.92" width="656.44" height="16.1" as="geometry"/></mxCell>
