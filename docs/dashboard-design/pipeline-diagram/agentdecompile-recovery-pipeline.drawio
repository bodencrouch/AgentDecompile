        <mxCell id="c397" value="OUTPUTS  →  who consumes them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=12;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-B"><mxGeometry x="3098" y="69.4" width="214.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c398" value="→ logical_signature per entity + per-build coverage · entities[] catalog (30 kinds, pack enum)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-B"><mxGeometry x="3098" y="93.92" width="611.36" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c399" value="→ data-root recipes with ordered fallbacks · divergence class per pair · caves[] + ABI blocks" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-B"><mxGeometry x="3098" y="110.92" width="604.92" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c400" value="→ all of it lands in hookpack v2 → consumed by lane C (runtime) and the export bundle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-B"><mxGeometry x="3098" y="127.92" width="553.4" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c401" value="→ generic core + adapters: a new engine adds an L3 data pack, never core code" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-B"><mxGeometry x="3098" y="144.92" width="501.88" height="16.1" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Lane C: Runtime reuse &amp; learn-the-build — branches after identity/ABI evidence, before whole-image recovery&#10;&#10;In the app: `?node=lane-C`&#10;&#10;- Family: runtime reuse / learn (RUNTIME)&#10;- Catalog verbs: unmapped (no recorded mapping)&#10;- Connects: branches after stages 1 to 2 evidence, consumes lane B's pack, feeds evidence back into stage 1&#10;- Scope: calling original code never counts as recovered source; observations feed back as evidence with provenance&#10;- Outputs and who consumes them:&#10;  - resolved sites per build + WHICH ladder member resolved each (feeds coverage + readiness)&#10;  - observations then runtime_claim + observed_status; promotion only through bind_identities&#10;  - build reports then provisional claims then independent acceptance or named unresolved outcomes&#10;  - never promotes source parity; never counts original bytes as recovered C" link="agentdecompile-recovery-pipeline.outline.md#lane-C" id="lane-C"><mxCell style="group" vertex="1" connectable="0" parent="L3"><mxGeometry x="60" y="1240" width="4300" height="274" as="geometry"/></mxCell></UserObject>
