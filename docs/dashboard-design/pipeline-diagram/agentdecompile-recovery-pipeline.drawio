        <mxCell id="c126" value="in: scaffold + decompiler output" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#98a0ad;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-4"><mxGeometry x="81.72" y="206.45" width="203.12" height="15.4" as="geometry"/></mxCell>
