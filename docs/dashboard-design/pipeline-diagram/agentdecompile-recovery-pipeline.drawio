        <mxCell id="c647" value="OUTPUTS  →  who consumes them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=12;fontColor=#b0b6c2;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c956"><mxGeometry x="14" y="11.4" width="214.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c648" value="→ one package (CLI adgrid) reusable for any CPU/IO-heavy work; the pipeline's lanes are adapters over it" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c956"><mxGeometry x="14" y="35.92" width="675.76" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c649" value="→ landed as a walking skeleton (U120–U124); integrator U125 next; adapters as units (plan Phase 15)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c956"><mxGeometry x="14" y="52.92" width="643.56" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c650" value="→ every stage runs as grid tasks: compile / parity / decompile / cascade / export lanes, each a proposal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c956"><mxGeometry x="14" y="69.92" width="675.76" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c651" value="→ the corpus store and the similarity index become views; hangs are named timeouts; nothing donated writes identity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c956"><mxGeometry x="14" y="86.92" width="746.6" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c652" value="EXHAUSTIVE RESOLUTION LADDERS — a locator failing means 'try the next relationship', not 'stop'. Unresolved = the residue after EVERY strategy." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=15;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="L4"><mxGeometry x="40" y="2102.25" width="1293" height="21" as="geometry"/></mxCell>
