        <mxCell id="c749" value="" style="rounded=0;fillColor=#5a4420;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="ladder-C"><mxGeometry x="0" y="22" width="460" height="8" as="geometry"/></mxCell>
