        <mxCell id="c6" value="HOW TO READ THIS IN 20 SECONDS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=12;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c946"><mxGeometry x="12" y="9.4" width="222" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c7" value="1. Follow prerequisites; identity/calibration iterate and parity runs continuously." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c946"><mxGeometry x="12" y="29.92" width="540.52" height="16.1" as="geometry"/></mxCell>
