        <mxCell id="c620" value="verified records: deletable, rebuildable, never locked by work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="65.92" width="411.72" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c621" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#b0b6c2;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="85.98" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c622" value="• one applier per view; bounded transactions; ack after commit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="100.45" width="387.92" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c623" value="• identity / logical / match / knowledge / receipts from deltas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="114.95" width="394.08" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c624" value="• view-stale is a named state with an age (H11), never a stall" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="129.45" width="387.92" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c625" value="• no worker ever opens a view for writing (H1 by construction)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c981"><mxGeometry x="10" y="143.95" width="387.92" height="15.4" as="geometry"/></mxCell>
