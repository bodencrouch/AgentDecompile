        <mxCell id="c656" value="→ timeouts record attempt outcomes, not termination; resource release requires evidence; independent acceptance only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c961"><mxGeometry x="14" y="86.92" width="753.04" height="16.1" as="geometry"/></mxCell>
