        <mxCell id="c134" value="G" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="gate-4-5"><mxGeometry x="61.1" y="10.45" width="12.6" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c135" value="candidate" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10.5;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="gate-4-5"><mxGeometry x="36.05" y="38.97" width="62.7" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c136" value="compile + compatibility" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10;fontColor=#98a0ad;fontStyle=2;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="gate-4-5"><mxGeometry x="0" y="52.5" width="134.8" height="14" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Stage 5: Propagation (cross-place)&#10;&#10;In the app: `?node=stage-5`&#10;&#10;- Family: source recovery (SOURCE RECOVERY)&#10;- Catalog verbs (consolidated plan §2.1): `corpus.cross-place`&#10;- Tag: the cross-match tier&#10;- Trying to: Reuse a donor candidate only for compatible recipient implementation variants; each recipient earns its own acceptance.&#10;- How:&#10;  - compile + variant/ABI/layout compatibility gate&#10;  - then byte-exact verify then permuter then LLM last&#10;  - a logical_id bind alone NEVER authorizes copying&#10;  - ABI-sensitive types re-validated per recipient&#10;  - field-level knowledge fusion runs alongside (lane A)&#10;- In to out:&#10;  - in: compile receipts + identity table&#10;  - out: recipient candidates; separate verification&#10;- Gate: candidate distribution is not accepted source. In the app: `?node=gate-5`" link="agentdecompile-recovery-pipeline.outline.md#stage-5" id="stage-5"><mxCell style="group" vertex="1" connectable="0" parent="L2"><mxGeometry x="2340" y="200" width="400" height="380" as="geometry"/></mxCell></UserObject>
        <mxCell id="c137" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#20232a;strokeColor=#3a3f4a;strokeWidth=1.2;html=1;whiteSpace=wrap;" vertex="1" parent="stage-5"><mxGeometry x="0" y="0" width="400" height="380" as="geometry"/></mxCell>
        <mxCell id="c138" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#25503e;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="stage-5"><mxGeometry x="0" y="0" width="400" height="30" as="geometry"/></mxCell>
