        <mxCell id="c641" value="• adgrid fleet up / down / status / replace; manifest as objects" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c982"><mxGeometry x="10" y="100.45" width="400.24" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c642" value="• providers: manual · ssh · declared cloud adapters" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c982"><mxGeometry x="10" y="114.95" width="320.16" height="15.4" as="geometry"/></mxCell>
