        <mxCell id="c94" value="Reconstruct objects and placement from the image;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="50.93" width="321.56" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c95" value="keep uncertain boundaries in larger regions;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="65.93" width="289.36" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c96" value="prove reconstruction before scaling source work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="80.93" width="315.12" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c97" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10.5;fontColor=#7fd6a4;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="100.97" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c98" value="• bytes + fixups + refs + data + unwind metadata" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="115.45" width="301.68" height="15.4" as="geometry"/></mxCell>
