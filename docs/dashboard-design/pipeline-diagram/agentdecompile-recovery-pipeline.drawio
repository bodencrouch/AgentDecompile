        <mxCell id="c944" value="" style="group" vertex="1" connectable="0" parent="L2"><mxGeometry x="474" y="190" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="c39" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#20232a;strokeColor=#3a3f4a;strokeWidth=1.2;html=1;whiteSpace=wrap;" vertex="1" parent="c944"><mxGeometry x="0" y="0" width="400" height="330" as="geometry"/></mxCell>
        <mxCell id="c40" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#2b4a7a;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="c944"><mxGeometry x="0" y="0" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="c41" value="" style="rounded=0;fillColor=#2b4a7a;strokeColor=none;html=1;whiteSpace=wrap;" vertex="1" parent="c944"><mxGeometry x="0" y="22" width="400" height="8" as="geometry"/></mxCell>
        <mxCell id="c42" value="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=13;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="6.35" width="13.8" height="18.2" as="geometry"/></mxCell>
        <mxCell id="c43" value="Identity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=13.5;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="44" y="5.83" width="70.8" height="18.9" as="geometry"/></mxCell>
        <mxCell id="c44" value="∥ extraction + indexing run in parallel" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#8cbaff;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="138.3" y="8.97" width="251.7" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c45" value="Trying to:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#8cbaff;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="36.97" width="69" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c46" value="Decide which functions/entities across builds are" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="50.92" width="321.56" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c47" value="the SAME logical thing — once, with evidence," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="65.93" width="295.8" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c48" value="never by address, never by bytes alone." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="80.93" width="257.16" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c49" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#8cbaff;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="100.97" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c50" value="• extract facts once; short-circuit identical images" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="115.45" width="326.32" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c51" value="• cheap-first cascade: symbols/provenance → exact &amp;amp;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="129.95" width="320.16" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c52" value="•   reloc-normalized hashes → rare refs / C++ meta →" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="144.45" width="326.32" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c53" value="•   neighborhood → CFG/SPP → BSim → ABI → optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="158.95" width="314" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c54" value="•   BinDiff/BinExport → optional emulation on residue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="173.45" width="332.48" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c55" value="• require uniqueness + margin; keep ambiguity;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c944"><mxGeometry x="10" y="187.95" width="289.36" height="15.4" as="geometry"/></mxCell>
