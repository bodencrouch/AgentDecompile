        <mxCell id="c49" value="Decide which functions/entities across builds are" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="50.93" width="321.56" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c50" value="logical entity, implementation variant and instance;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="65.93" width="340.88" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c51" value="similarity does not prove interchangeable behavior." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="80.93" width="334.44" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c52" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10.5;fontColor=#8cbaff;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="100.97" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c53" value="• extract facts once; short-circuit identical images" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="115.45" width="326.32" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c54" value="• cheap-first cascade: symbols/provenance → exact &amp;amp;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="129.95" width="320.16" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c55" value="•   reloc-normalized hashes → rare refs / C++ meta →" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="144.45" width="326.32" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c56" value="•   neighborhood → CFG/SPP → BSim → ABI → optional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="158.95" width="314" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c57" value="•   BinDiff/BinExport → optional emulation on residue" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="173.45" width="332.48" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c58" value="• require uniqueness + margin; keep ambiguity;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="187.95" width="289.36" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c59" value="•   withdraw bad seeds + unsupported descendants" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-1"><mxGeometry x="10" y="202.45" width="301.68" height="15.4" as="geometry"/></mxCell>
