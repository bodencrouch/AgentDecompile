        <mxCell id="c598" value="• result-proposed → verified only by an independent key" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c975"><mxGeometry x="10" y="85.45" width="344.8" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c599" value="• recompute or hash-lookup; byte-exact = recompile + parity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c975"><mxGeometry x="10" y="99.95" width="369.44" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c600" value="• no quorum, no credit, no reputation; a liar wastes ≤ 4 verifies" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c975"><mxGeometry x="10" y="114.45" width="406.4" height="15.4" as="geometry"/></mxCell>
