        <mxCell id="c472" value="→ observations → runtime_claim + observed_status; promotion only through bind_identities" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-C"><mxGeometry x="2070" y="110.92" width="572.72" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c473" value="→ build reports → provisional claims → independent acceptance or named unresolved outcomes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-C"><mxGeometry x="2070" y="127.92" width="585.6" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c474" value="→ never promotes source parity; never counts original bytes as recovered C" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-C"><mxGeometry x="2070" y="144.92" width="482.56" height="16.1" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Lane D: Verification &amp; determinism — same inputs then byte-identical outputs, under a declared basis&#10;&#10;In the app: `?node=lane-D`&#10;&#10;- Family: verification &amp; determinism (VERIFICATION)&#10;- Catalog verbs: unmapped (no recorded mapping)&#10;- Connects: wraps every stage and lane, gates every export&#10;- Scope: replay recorded proposals and observations under a versioned basis; discovery itself need not be deterministic&#10;- Outputs and who consumes them:&#10;  - the basis object stamped into every pack, header, report and receipt&#10;  - two pass/fail gates in CI: export byte-diff and the cascade harness&#10;  - content-addressed receipts then identical-basis re-runs are cache hits&#10;  - basis change then deliberate re-baseline with a recorded supersession, never silent drift" link="agentdecompile-recovery-pipeline.outline.md#lane-D" id="lane-D"><mxCell style="group" vertex="1" connectable="0" parent="L3"><mxGeometry x="60" y="1514" width="4300" height="306" as="geometry"/></mxCell></UserObject>
        <mxCell id="c475" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#452a5a;strokeColor=none;opacity=85;html=1;whiteSpace=wrap;" vertex="1" parent="lane-D"><mxGeometry x="0" y="16" width="4300" height="34" as="geometry"/></mxCell>
        <mxCell id="c476" value="LANE D · Verification &amp;amp; determinism — same inputs → byte-identical outputs, under a declared basis" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=14;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="12" y="23.3" width="829.2" height="19.6" as="geometry"/></mxCell>
