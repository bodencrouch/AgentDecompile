        <mxCell id="c225" value="RUNS CONCURRENTLY WITH STAGES 1–8 (where ownership permits)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=12.5;fontColor=#f0c060;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;rotation=-90;" vertex="1" parent="lanes"><mxGeometry x="0" y="716.25" width="448.5" height="17.5" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Lane A: Knowledge fusion — bidirectional, per field&#10;&#10;In the app: `?node=lane-A`&#10;&#10;- Family: cross-build unification &amp; export (UNIFICATION &amp; EXPORT)&#10;- Catalog verbs: unmapped (no recorded mapping)&#10;- Connects: consumes stage 1 identity, runs beside stages 4 to 5, feeds every sibling build&#10;- Scope: labels, comments, structs/types, debug-info names flow between every build sharing a logical id; strongest source per field wins; a build donates a FIELD, never everything&#10;- Outputs and who consumes them:&#10;  - merged names / types / comments PER FIELD, each with origin and rejected alternatives&#10;  - consumed by stage 5 placement (type-compatibility gate) and by the ABI + struct blocks of the pack&#10;  - surfaces in the readiness report as which build donated which field&#10;  - never overwrites a stronger field; conflicts stay visible for review" link="agentdecompile-recovery-pipeline.outline.md#lane-A" id="lane-A"><mxCell style="group" vertex="1" connectable="0" parent="L3"><mxGeometry x="60" y="660" width="4300" height="274" as="geometry"/></mxCell></UserObject>
        <mxCell id="c226" value="" style="rounded=1;absoluteArcSize=1;arcSize=8;fillColor=#5a4420;strokeColor=none;opacity=85;html=1;whiteSpace=wrap;" vertex="1" parent="lane-A"><mxGeometry x="0" y="16" width="4300" height="34" as="geometry"/></mxCell>
        <mxCell id="c227" value="LANE A · Knowledge fusion — bidirectional, per field" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=14;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="12" y="23.3" width="442.8" height="19.6" as="geometry"/></mxCell>
        <mxCell id="c228" value="UNIFICATION &amp;amp; EXPORT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="466.8" y="27.5" width="126" height="14" as="geometry"/></mxCell>
        <mxCell id="c229" value="labels · comments · structs/types · debug-info names flow between every build sharing a logical id; strongest source per field wins; a build donates a FIELD, never everything" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#f0c060;fontStyle=2;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-A"><mxGeometry x="3161.44" y="25.93" width="1126.56" height="16.1" as="geometry"/></mxCell>
