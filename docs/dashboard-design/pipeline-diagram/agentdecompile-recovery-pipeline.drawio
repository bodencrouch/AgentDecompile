        <mxCell id="c868" value="Show the named owner/provider failure, last evidence, chosen fallback," style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c993"><mxGeometry x="12" y="64.45" width="437.2" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c869" value="retry eligibility. No silent retry storm. No stale-state reset. No restart." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c993"><mxGeometry x="12" y="79.45" width="468" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c870" value="A job past its deadline is a NAMED failure (verb + elapsed), never a wait;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c993"><mxGeometry x="12" y="94.45" width="461.84" height="15.4" as="geometry"/></mxCell>
