        <mxCell id="c100" value="• extract → emit → place → compare original bytes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="144.45" width="307.84" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c101" value="• then prove a compiled replacement actually contributes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="stage-3"><mxGeometry x="10" y="158.95" width="350.96" height="15.4" as="geometry"/></mxCell>
