        <mxCell id="c632" value="Trying to:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=10.5;fontColor=#b0b6c2;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="36.98" width="69" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c633" value="The operator never depends on volunteers: rented" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="50.92" width="315.12" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c634" value="free-tier nodes join with the same command in cloud-init." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="65.92" width="373.08" height="16.1" as="geometry"/></mxCell>
