        <mxCell id="c531" value="Change the basis deliberately, never silently." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D-card-4"><mxGeometry x="10" y="50.92" width="302.24" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c532" value="How:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=10.5;fontColor=#c9a4f0;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D-card-4"><mxGeometry x="10" y="70.98" width="31.2" height="14.7" as="geometry"/></mxCell>
        <mxCell id="c533" value="• receipts hash relevant dependencies + snapshot" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D-card-4"><mxGeometry x="10" y="85.45" width="301.68" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c534" value="• changed input → invalidate affected descendants" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D-card-4"><mxGeometry x="10" y="99.95" width="307.84" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c535" value="• acceptance rejects stale versions; old packs readable" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D-card-4"><mxGeometry x="10" y="114.45" width="344.8" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c536" value="" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#16181c;strokeColor=#c9a4f0;strokeWidth=1.2;dashed=1;dashPattern=5 4;fixDash=1;html=1;whiteSpace=wrap;" vertex="1" parent="lane-D"><mxGeometry x="2056" y="58" width="2244" height="248" as="geometry"/></mxCell>
        <mxCell id="c537" value="OUTPUTS  →  who consumes them" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=12;fontColor=#c9a4f0;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="2070" y="69.4" width="214.8" height="16.8" as="geometry"/></mxCell>
        <mxCell id="c538" value="→ the basis object stamped into every pack, header, report and receipt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="2070" y="93.92" width="456.8" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c539" value="→ two pass/fail gates in CI: export byte-diff and the cascade harness" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="2070" y="110.92" width="450.36" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c540" value="→ content-addressed receipts → identical-basis re-runs are cache hits" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="2070" y="127.92" width="450.36" height="16.1" as="geometry"/></mxCell>
        <mxCell id="c541" value="→ basis change → deliberate re-baseline with a recorded supersession, never silent drift" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=11.5;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="lane-D"><mxGeometry x="2070" y="144.92" width="572.72" height="16.1" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Lane E: Distributed compute (agentdecompile_grid) — laptop then concurrency then donated idle compute and free cloud nodes&#10;&#10;In the app: `?node=lane-E`&#10;&#10;- Family: intake / cross-cutting (INTAKE)&#10;- Catalog verbs: unmapped (no recorded mapping)&#10;- Connects: wraps every stage and lane, one-command join, fleet of free cloud nodes&#10;- Scope: content-addressed objects, per-partition logs, every result a proposal, capability by canary, never by role, SQLite as a materialized view&#10;- Outputs and who consumes them:&#10;  - one package (CLI adgrid) reusable for any CPU/IO-heavy work; the pipeline's lanes are adapters over it&#10;  - planned grid contracts; implementation status belongs to delivery evidence, not this design diagram&#10;  - every stage runs as grid tasks: compile / parity / decompile / cascade / export lanes, each a proposal&#10;  - timeouts record attempt outcomes, not termination; resource release requires evidence; independent acceptance only" link="agentdecompile-recovery-pipeline.outline.md#lane-E" id="lane-E"><mxCell style="group" vertex="1" connectable="0" parent="L3"><mxGeometry x="60" y="1820" width="4300" height="306" as="geometry"/></mxCell></UserObject>
