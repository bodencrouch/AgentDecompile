        <mxCell id="c636" value="• adgrid fleet up / down / status / replace; manifest as objects" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="100.45" width="400.24" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c637" value="• providers: manual · ssh · declared cloud adapters" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="114.95" width="320.16" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c638" value="• lane placement by canary, never by tier or role" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="129.45" width="307.84" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c639" value="• fleet keys sign invites, verify, apply — no laptop SPOF (H13)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="143.95" width="394.08" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c640" value="• preemptible by design: advisory intents; loss stalls, never loses" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="158.45" width="418.72" height="15.4" as="geometry"/></mxCell>
