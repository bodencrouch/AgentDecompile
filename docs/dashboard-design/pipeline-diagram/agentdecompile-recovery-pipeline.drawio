        <mxCell id="c642" value="in: provider credentials via the secret path; an invite" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#98a0ad;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c977"><mxGeometry x="10" y="191.95" width="344.8" height="15.4" as="geometry"/></mxCell>
