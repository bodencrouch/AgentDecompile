        <mxCell id="c563" value="• intents are advisory TTL hints; a lost lease wastes compute only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c973"><mxGeometry x="10" y="129.45" width="412.56" height="15.4" as="geometry"/></mxCell>
        <mxCell id="c564" value="• kill deadline per kind → result-timeout record; 3 → task-poison" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=Inter;fontSize=11;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="c973"><mxGeometry x="10" y="143.95" width="406.4" height="15.4" as="geometry"/></mxCell>
