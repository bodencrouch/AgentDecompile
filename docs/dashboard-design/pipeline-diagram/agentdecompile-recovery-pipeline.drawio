        <UserObject label="" tooltip="Gate between stage 4 and stage 5: candidate&#10;&#10;In the app: `?node=gate-4-5`&#10;&#10;A gate diamond on the dependency arrow from stage 4 to stage 5. Label: candidate. Condition: compile + compatibility." link="agentdecompile-recovery-pipeline.outline.md#gate-4-5" id="gate-4-5"><mxCell style="group" vertex="1" connectable="0" parent="L2"><mxGeometry x="2190.6" y="372" width="134.8" height="66.5" as="geometry"/></mxCell></UserObject>
