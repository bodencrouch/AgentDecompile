        <mxCell id="c91" value="Release needs corroborated end of access + owner" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="quarantine"><mxGeometry x="16" y="92.15" width="462.96" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c92" value="Atomic local locks; PID identity alone is insufficient" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="quarantine"><mxGeometry x="16" y="117.15" width="520.08" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c93" value="Private replacement only on disjoint safe resources" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="quarantine"><mxGeometry x="16" y="142.15" width="491.52" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c94" value="Bound isolated storage probes; never block scheduler" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="quarantine"><mxGeometry x="16" y="167.15" width="501.04" height="23.8" as="geometry"/></mxCell>
        <UserObject label="" tooltip="CONTINUE: Only ready independent work&#10;&#10;In the app: `?node=continue`&#10;&#10;- Transient failure: one owner, bounded durable retry&#10;- Deterministic negative: changed hypothesis required&#10;- Provider circuit break; split task or compatible route&#10;- No ready work: persist dependency sets + wake event&#10;- Complete remote replica + worker needed for host loss&#10;- New user message does not reset retry budget" link="execution-contracts.outline.md#continue" id="continue"><mxCell style="group" vertex="1" connectable="0" parent="L4"><mxGeometry x="1215" y="980" width="550" height="235" as="geometry"/></mxCell></UserObject>
