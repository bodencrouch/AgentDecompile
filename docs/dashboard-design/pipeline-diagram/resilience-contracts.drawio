        <mxCell id="c67" value="CONTROL PLANE · Fail read-only" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=21;fontColor=#ef968b;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="control-plane"><mxGeometry x="16" y="7.95" width="384" height="29.4" as="geometry"/></mxCell>
        <mxCell id="c68" value="Lost durable decision or acceptance authority:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="control-plane"><mxGeometry x="16" y="45.15" width="443.92" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c69" value="pause new managed mutation/admission in that scope" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="control-plane"><mxGeometry x="16" y="71.15" width="482" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c70" value="Keep cached read-only evidence available with age" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="control-plane"><mxGeometry x="16" y="97.15" width="472.48" height="23.8" as="geometry"/></mxCell>
