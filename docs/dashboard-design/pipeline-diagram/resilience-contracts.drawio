        <mxCell id="c91" value="No broader rollout from a successful process exit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="policy-canary"><mxGeometry x="16" y="123.15" width="472.48" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c92" value="Revert routing/admission version if metric regresses" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="policy-canary"><mxGeometry x="16" y="149.15" width="501.04" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c93" value="Reassess active attempts under their recorded policy" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="policy-canary"><mxGeometry x="16" y="175.15" width="501.04" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c94" value="Accept only with pinned/current policy compatibility" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="policy-canary"><mxGeometry x="16" y="201.15" width="501.04" height="23.8" as="geometry"/></mxCell>
        <mxCell id="c95" value="Wake: accepted policy version or corrected evidence" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=17;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="policy-canary"><mxGeometry x="16" y="227.15" width="491.52" height="23.8" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Worked interruption, the command was sent, then the decision store disappeared&#10;&#10;In the app: `?node=worked-interruption`&#10;&#10;Observe: command ID C may have changed the game; the connection closed before its result was durably recorded.&#10;&#10;Contain: pause new managed mutations in this scope; preserve read-only status and existing evidence; do not replay C.&#10;&#10;Recover: reconcile C against observed engine state and ownership. Resume only after durable authority and state agree.&#10;&#10;Future proof: inject disconnect; show no blind duplicate dispatch, retained unknown outcome, reconciliation and scoped resumption.&#10;&#10;If the effect cannot be determined, keep the affected operation waiting and expose the exact required observation.&#10;&#10;Status: NOT RUN, design acceptance is artifact consistency; runtime recovery needs the future measurements specified in the plan." link="resilience-contracts.outline.md#worked-interruption" id="worked-interruption"><mxCell style="group" vertex="1" connectable="0" parent="L4"><mxGeometry x="35" y="1115" width="1730" height="285" as="geometry"/></mxCell></UserObject>
