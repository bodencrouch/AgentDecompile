<mxfile host="local" agent="svg_to_drawio.py" version="24.7.17">
  <diagram id="resilience-contracts" name="Prevention, containment and recovery">
    <mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1800" pageHeight="1435" background="#16181c" math="0" shadow="0">
      <root>
        <UserObject label="" description="Reading order: six lifecycle steps (prevent, detect and classify; record the decision; repair, reroute or wait; accept against the current basis; resume only the justified capability; prevent recurrence), then the control-plane, data/provider and policy/canary containment boundaries and a worked interruption. Every recovery action returns through independent acceptance, and an available process is not a repaired capability. Design only: failure-injection checks are NOT RUN; resilience-contracts.outline.md is the text outline." id="0"><mxCell/></UserObject>
        <mxCell id="1" value="Canvas" style="locked=1;" parent="0"/>
        <mxCell id="L1" value="Failure lifecycle" style="" parent="0"/>
        <mxCell id="L2" value="Acceptance and preventive feedback" style="" parent="0"/>
        <mxCell id="L3" value="Failure containment boundaries" style="" parent="0"/>
        <mxCell id="L4" value="Worked interruption and evidence boundary" style="" parent="0"/>
        <mxCell id="c2" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#16181c;strokeColor=#16181c;strokeWidth=1;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1800" height="1435" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Prevention, containment and recovery&#10;&#10;In the app: `?node=resil-header`&#10;&#10;Text outline of resilience-contracts.svg; the primary accessible reading form of that diagram. Each anchor equals the node id in `pipeline-model.json`, the `&lt;g id&gt;` in the SVG and the object id in the `.drawio` file, whose single link per object points back to this anchor. &quot;In the app&quot; gives each node's location in the workbench, which resolves it against the active project. Symbols that carry meaning are spelled out in words.&#10;&#10;Summary: Reading order: six lifecycle steps (prevent, detect and classify; record the decision; repair, reroute or wait; accept against the current basis; resume only the justified capability; prevent recurrence), then the control-plane, data/provider and policy/canary containment boundaries and a worked interruption. Every recovery action returns through independent acceptance, and an available process is not a repaired capability. Design only: failure-injection checks are NOT RUN; resilience-contracts.outline.md is the text outline.&#10;&#10;DESIGN ONLY, future failure-injection checks NOT RUN, implement locally first using existing task/corpus contracts&#10;&#10;One durable decision owner. Recover the affected dependency; retain the objective, evidence and independent work." link="resilience-contracts.outline.md#resil-header" id="resil-header"><mxCell style="group" vertex="1" connectable="0" parent="1"><mxGeometry x="35" y="9.4" width="1175.28" height="105.9" as="geometry"/></mxCell></UserObject>
        <mxCell id="c3" value="Prevention, containment and recovery" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=32;fontColor=#f2f4f7;fontStyle=1;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="resil-header"><mxGeometry x="0" y="0" width="697.2" height="44.8" as="geometry"/></mxCell>
        <mxCell id="c4" value="DESIGN ONLY · future failure-injection checks NOT RUN · implement locally first using existing task/corpus contracts" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=18;fontColor=#f0c060;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="resil-header"><mxGeometry x="0" y="49.7" width="1175.28" height="25.2" as="geometry"/></mxCell>
        <mxCell id="c5" value="One durable decision owner. Recover the affected dependency; retain the objective, evidence and independent work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;overflow=visible;fontFamily=DejaVu Sans;fontSize=18;fontColor=#d8dbe0;spacing=0;spacingLeft=0;spacingRight=0;spacingTop=0;spacingBottom=0;" vertex="1" parent="resil-header"><mxGeometry x="0" y="80.7" width="1145.04" height="25.2" as="geometry"/></mxCell>
        <UserObject label="" tooltip="Step 1: Prevent, detect, classify&#10;&#10;In the app: `?node=resil-step-1`&#10;&#10;- Fixture recheck after ownership, before mutation&#10;- Observe process tree, unit receipts and goal facts&#10;- Classify: mismatch / transient / resource / policy&#10;- Distinguish missing evidence from unhealthy resource&#10;- Unknown outcome stays unknown until reconciled&#10;- No health decision from one noisy sample alone&#10;- Capture exact input, policy and observation versions" link="resilience-contracts.outline.md#resil-step-1" id="resil-step-1"><mxCell style="group" vertex="1" connectable="0" parent="L1"><mxGeometry x="35" y="140" width="550" height="260" as="geometry"/></mxCell></UserObject>
