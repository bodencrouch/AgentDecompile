{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GHIDRA_DECOMP_BUILD_TESTS": "ON",
        "GHIDRA_DECOMP_INSTALL": "OFF",
        "GHIDRA_DECOMP_CONSOLE": "ON",
        "GHIDRA_DECOMP_BFD": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GNSDK_ENABLE_TEST_HOOKS": "ON"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo (default)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GNSDK_ENABLE_TEST_HOOKS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_NM": "/usr/bin/nm",
        "GNSDK_SANITIZE": "address",
        "GNSDK_ENABLE_TEST_HOOKS": "ON"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_init_order=0"
      }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GNSDK_SANITIZE": "undefined",
        "GNSDK_ENABLE_TEST_HOOKS": "ON"
      },
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer (clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "GNSDK_SANITIZE": "address,fuzzer-no-link",
        "GNSDK_FUZZ": "ON",
        "GNSDK_ENABLE_TEST_HOOKS": "ON"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_init_order=0"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 4 },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "jobs": 4 },
    { "name": "asan", "configurePreset": "asan", "jobs": 4 },
    { "name": "ubsan", "configurePreset": "ubsan", "jobs": 4 },
    { "name": "fuzz", "configurePreset": "fuzz", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false, "jobs": 1 }
    },
    { "name": "debug", "configurePreset": "debug", "inherits": "base-test" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo", "inherits": "base-test" },
    { "name": "asan", "configurePreset": "asan", "inherits": "base-test" },
    { "name": "ubsan", "configurePreset": "ubsan", "inherits": "base-test" },
    { "name": "fuzz", "configurePreset": "fuzz", "inherits": "base-test" }
  ],
  "workflowPresets": [
    {
      "name": "relwithdebinfo",
      "steps": [
        { "type": "configure", "name": "relwithdebinfo" },
        { "type": "build", "name": "relwithdebinfo" },
        { "type": "test", "name": "relwithdebinfo" }
      ]
    }
  ]
}
