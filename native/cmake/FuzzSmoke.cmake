if(NOT DEFINED FUZZ_EXECUTABLE OR NOT DEFINED FUZZ_CORPUS_DIR OR NOT DEFINED FUZZ_WORK_DIR OR NOT DEFINED FUZZ_ARTIFACT_DIR)
  message(FATAL_ERROR "FUZZ_EXECUTABLE, FUZZ_CORPUS_DIR, FUZZ_WORK_DIR, and FUZZ_ARTIFACT_DIR are required")
endif()

file(REMOVE_RECURSE "${FUZZ_WORK_DIR}")
file(MAKE_DIRECTORY "${FUZZ_WORK_DIR}" "${FUZZ_ARTIFACT_DIR}")
file(COPY "${FUZZ_CORPUS_DIR}/" DESTINATION "${FUZZ_WORK_DIR}")

execute_process(
  COMMAND "${FUZZ_EXECUTABLE}" -runs=1000 -seed=12345 -artifact_prefix=${FUZZ_ARTIFACT_DIR}/ "${FUZZ_WORK_DIR}"
  RESULT_VARIABLE fuzz_result
)

if(NOT fuzz_result EQUAL 0)
  message(FATAL_ERROR "fuzzer smoke run failed with status ${fuzz_result}: ${FUZZ_EXECUTABLE}")
endif()
